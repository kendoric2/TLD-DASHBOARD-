# Secrets — never commit
.env

# Local data / probe output (may contain customer PII) — never commit
policy_*.txt
*.local.json
*.xlsx
egress_columns.xlsx

# Internal blueprint / docs — kept locally, not committed
docs/

# Logs / metrics — local operational data, not committed
logs/

# Saved TLD rows for past ranges — derived data, rebuilt on demand
cache/

# Node and the compiled F#
node_modules/
/generated/
fable_modules/
/core/obj/
/core/bin/

# The old Python version's virtualenv, if one is still on disk
__pycache__/
.venv/

# OS / editor
.DS_Store
*.log

# Local push helper — keep on disk, but out of the repo
push_to_github.command
